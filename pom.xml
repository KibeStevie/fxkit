<?xml version="1.0" encoding="UTF-8"?>
<!--
  FXKit parent POM (Story: "Create the parent POM")

  Role: this file owns the settings shared by every module:
    - which modules exist            (<modules>)
    - which Java / JavaFX versions   (<properties>)
    - dependency & plugin versions   (<dependencyManagement>, <pluginManagement>)
  Child modules declare WHAT they use; this file decides WHICH VERSION.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- NOTE: groupId is a placeholder. Before publishing to Maven Central (Phase 7)
       change it to a namespace you can verify, e.g. io.github.<your-github-username> -->
  <groupId>dev.fxkit</groupId>
  <artifactId>fxkit-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>  <!-- a parent/aggregator produces no jar, only a pom -->

  <name>FXKit</name>
  <description>Tailwind-inspired UI component library for JavaFX desktop apps</description>

  <modules>
    <module>fxkit-core</module>
    <module>fxkit-showcase</module>
  </modules>

  <properties>
    <!-- Java 25 -->
    <maven.compiler.release>25</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <!-- JavaFX 25 (25.0.1 is a patch release of 25; bump the patch number when a newer one is out) -->
    <javafx.version>25.0.1</javafx.version>

    <!-- Plugin versions -->
    <maven-compiler-plugin.version>3.14.1</maven-compiler-plugin.version>
    <javafx-maven-plugin.version>0.0.8</javafx-maven-plugin.version>
    <maven-surefire-plugin.version>3.5.4</maven-surefire-plugin.version>

    <!-- JUnit 5 (Story #26: "Add JUnit 5 and maven-surefire-plugin to the parent POM") -->
    <junit-jupiter.version>5.11.4</junit-jupiter.version>

    <!-- Ikonli (Story #36, stretch: icon support on FxButton). fxkit-core only depends on
         ikonli-core/ikonli-javafx (the Ikon type and FontIcon); an actual icon PACK is each
         consumer's own choice, never a fxkit-core dependency - see fxkit-core/pom.xml. -->
    <ikonli.version>12.4.0</ikonli.version>

    <!-- Build guards (added by the review). Bump to the newest releases on Maven Central. -->
    <maven-enforcer-plugin.version>3.5.0</maven-enforcer-plugin.version>
    <dependency-check-maven.version>12.1.0</dependency-check-maven.version>

    <!-- Reproducible builds: jars/zips get this fixed timestamp instead of "now", so the same
         source always produces byte-identical artifacts. Bump it when you cut a release. -->
    <project.build.outputTimestamp>2026-10-17T00:00:00Z</project.build.outputTimestamp>
  </properties>

  <!-- dependencyManagement = "if a module uses this, use THIS version".
       It does not add dependencies by itself. -->
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.openjfx</groupId>
        <artifactId>javafx-controls</artifactId>
        <version>${javafx.version}</version>
      </dependency>
      <dependency>
        <groupId>org.openjfx</groupId>
        <artifactId>javafx-fxml</artifactId>
        <version>${javafx.version}</version>
      </dependency>

      <!-- Our own library, so the showcase doesn't have to repeat the version -->
      <dependency>
        <groupId>${project.groupId}</groupId>
        <artifactId>fxkit-core</artifactId>
        <version>${project.version}</version>
      </dependency>

      <!-- JUnit 5: import the BOM so every jupiter artifact a module declares stays on one version -->
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit-jupiter.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <!-- Ikonli: import its BOM so ikonli-core/ikonli-javafx and any icon pack a module declares
           (fxkit-core: core+javafx only; fxkit-showcase: also a pack, for the showcase demo; see #36)
           stay on one version without every dependency repeating it. -->
      <dependency>
        <groupId>org.kordamp.ikonli</groupId>
        <artifactId>ikonli-bom</artifactId>
        <version>${ikonli.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <!-- pluginManagement = same idea, but for plugins -->
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${maven-compiler-plugin.version}</version>
          <!-- the Java level comes from the maven.compiler.release property above -->
          <configuration>
            <compilerArgs>
              <!-- all lint warnings on except this-escape (JavaFX components call overridable methods in constructors by design); add <arg>-Werror</arg> once the current ones are fixed -->
              <arg>-Xlint:all,-this-escape</arg>
              <!-- keep parameter names for reflection (FXML, property binding, debugging) -->
              <arg>-parameters</arg>
            </compilerArgs>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-enforcer-plugin</artifactId>
          <version>${maven-enforcer-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.openjfx</groupId>
          <artifactId>javafx-maven-plugin</artifactId>
          <version>${javafx-maven-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${maven-surefire-plugin.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>

    <!-- plugins listed here (outside pluginManagement) are actually applied to all modules -->
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
      </plugin>
      <!-- Fails the build early on a wrong JDK/Maven or on dependency drift. If dependencyConvergence
           reports a conflict, pin the winner in <dependencyManagement> above. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-build-rules</id>
            <phase>validate</phase>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireMavenVersion>
                  <version>[3.9.0,)</version>
                </requireMavenVersion>
                <requireJavaVersion>
                  <version>[${maven.compiler.release},)</version>
                </requireJavaVersion>
                <banDuplicatePomDependencyVersions/>
                <dependencyConvergence/>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <!-- JavaFX loads native libraries; without this every test run prints a
               "restricted method in java.lang.System has been called" warning.
               Tests run on the classpath (useModulePath=false below), where JavaFX is not a named
               module, so "javafx.graphics" would be reported as an unknown module: use ALL-UNNAMED. -->
          <argLine>--enable-native-access=ALL-UNNAMED</argLine>

          <!-- fxkit-core has a module-info.java, but only for src/main/java. Test classes live
               in a separate source root (src/test/java) that is patched into the module at test
               -compile time; the main module-info can't declare "opens" for test-only packages
               (they don't exist yet when module-info.java is compiled), and running tests on the
               module path with a module descriptor that doesn't cover them causes either
               IllegalAccessException (JUnit's reflective runner can't reach test classes) or, if
               you try to "fix" that from module-info.java, a corrupted module descriptor that
               crashes the forked test JVM outright. Running tests on the plain classpath instead
               sidesteps all of this - it's the standard approach for JPMS library modules with
               JUnit 5 unit tests, since the tests don't need real module boundaries. -->
          <useModulePath>false</useModulePath>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- Vulnerability scan of every dependency: mvn verify -Psecurity
         Needs an NVD API key (free, https://nvd.nist.gov/developers/request-an-api-key), passed as
         -Dnvd.api.key=... or the NVD_API_KEY environment variable. Kept out of the default build
         because the first run downloads the whole CVE database. -->
    <profile>
      <id>security</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.owasp</groupId>
            <artifactId>dependency-check-maven</artifactId>
            <version>${dependency-check-maven.version}</version>
            <configuration>
              <!-- fail on High/Critical (CVSS 7.0 and above) -->
              <failBuildOnCVSS>7</failBuildOnCVSS>
              <nvdApiKey>${env.NVD_API_KEY}</nvdApiKey>
            </configuration>
            <executions>
              <execution>
                <goals>
                  <goal>check</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
