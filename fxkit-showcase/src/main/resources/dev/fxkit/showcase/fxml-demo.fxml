<?xml version="1.0" encoding="UTF-8"?>

<?import dev.fxkit.core.components.FxButton?>
<?import dev.fxkit.core.components.FxCard?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<!--
  Loaded by dev.fxkit.showcase.FxmlDemoPage (issue #33) to prove FxButton and FxCard both work when
  built purely declaratively, from a module (dev.fxkit.showcase) other than the one that defines them
  (dev.fxkit.core). No fx:controller: every node here is built from its own no-arg constructor and
  standard property setters, which is all FXMLLoader needs. See docs/fxml-notes.md for anything that
  did need a workaround.
-->
<VBox xmlns:fx="http://javafx.com/fxml" spacing="16">

    <!-- Acceptance criterion: "An FXML file uses <FxButton variant="DANGER" size="LG" text="Delete"/>
         and loads without errors." -->
    <HBox spacing="12">
        <FxButton text="Save" variant="PRIMARY" size="MD"/>
        <FxButton text="Delete" variant="DANGER" size="LG"/>
        <!-- #36 stretch: a Node graphic (a plain FontIcon, no FxButton API needed for this path) -->
        <FxButton text="Java" variant="SECONDARY">
            <graphic><FontIcon iconLiteral="di-java"/></graphic>
        </FxButton>
    </HBox>

    <!-- Acceptance criterion: "FxCard slots can be filled in FXML (e.g. via @DefaultProperty or named
         child elements)." header/footer are named elements; body uses FxCard's @DefaultProperty. -->
    <FxCard elevation="MD">
        <header>
            <Label text="Delete account" styleClass="text-lg, font-semibold, text-body"/>
        </header>
        <Label text="This can't be undone." styleClass="text-sm, text-muted" wrapText="true"/>
        <footer>
            <FxButton text="Delete" variant="DANGER"/>
        </footer>
    </FxCard>
</VBox>
